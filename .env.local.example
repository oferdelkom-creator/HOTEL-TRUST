NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
RESEND_API_KEY=your-resend-api-key

# --- Telegram bingo bot (see docs/telegram-bingo.md) ---
# Service role key: the bot has no user session, so it talks to Supabase
# with this. Server-side only - never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Any long random string. Passed to setWebhook as secret_token and checked
# on every incoming update; without it the webhook refuses to run.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
# Bearer token for the /api/telegram/tick cron endpoint.
CRON_SECRET=generate-another-long-random-string
# Selling cards for Stars while paying Stars prizes is gambling. Leave unset.
# BINGO_PAID_CARDS=false
