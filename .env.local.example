NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role key in the Supabase dashboard.
# Used only by the payment webhook (server-side, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From your YooKassa merchant account (https://yookassa.ru). Use the
# sandbox/test shop credentials for local development.
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key

# Public base URL, used to build the YooKassa return_url. Must be a real
# public HTTPS URL in production (YooKassa's webhook can't reach localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
